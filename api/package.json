{
  "name": "erp-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.7.0",
    "bcrypt": "6.0.0",
    "fastify": "5.6.2",
    "ioredis": "5.8.2",
    "jose": "6.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/node": "22.18.6",
    "prisma": "6.7.0",
    "tsx": "4.20.3",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
