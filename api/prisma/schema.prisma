// ============================================================
// IDENTIDADE EXTERNA — NAO ADICIONAR:
// Activity, UserAccount
// Sao acessadas via ActivityGateway e AuthGateway.
// Family, Person e FamilyMembership pertencem a este repositorio
// (frente AD, modulo CAD) e sao persistidas abaixo.
// Ver docs/decisions/ADR-001-ad-gateways.md
// ============================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ServiceRecordStatus {
  COMPLETED
  CANCELED
  REVERSED
}

enum LocationType {
  URBAN
  RURAL
}

enum PersonSex {
  MALE
  FEMALE
  OTHER
}

model Family {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String             @unique
  referenceName String?            @db.VarChar(500)
  address       String?            @db.VarChar(500)
  neighborhood  String?            @db.VarChar(500)
  postalCode    String?            @db.Char(8)
  locationType  LocationType
  contactPhone  String?            @db.VarChar(50)
  searchText    String             @default("")
  revision      Int                @default(1)
  memberships   FamilyMembership[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([code])
  @@index([neighborhood])
  @@index([searchText])
}

model Person {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String             @db.VarChar(500)
  birthDate      DateTime?          @db.Date
  sex            PersonSex?
  cpf            String?            @db.Char(11)
  rg             String?            @db.VarChar(30)
  occupation     String?            @db.VarChar(100)
  educationLevel String?            @db.VarChar(100)
  contactPhone   String?            @db.VarChar(50)
  searchText     String             @default("")
  revision       Int                @default(1)
  memberships    FamilyMembership[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([name])
  @@index([cpf])
  @@index([searchText])
  // CPF has no unique constraint: duplicates are resolved by merge (RF-CAD-07),
  // never by rejecting the write. See SPEC-CAD.
}

model FamilyMembership {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId              String    @db.Uuid
  family                Family    @relation(fields: [familyId], references: [id])
  personId              String    @db.Uuid
  person                Person    @relation(fields: [personId], references: [id])
  relationshipToReference String? @db.VarChar(100)
  isReference           Boolean   @default(false)
  validFrom             DateTime  @db.Date
  validUntil            DateTime? @db.Date
  revision              Int       @default(1)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([personId, validFrom])
  @@index([familyId, validUntil])
  // MVP-D04 (single active membership per person) and single active holder
  // per family are enforced by partial unique indexes in the migration SQL:
  // membership_active_person, membership_active_holder.
}

model AuditEntry {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType String
  entityId   String   @db.Uuid
  action     String
  actorId    String?
  recordedAt DateTime @default(now()) @db.Timestamptz
  occurredAt DateTime @db.Timestamptz
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}

model ServiceRecord {
  id              String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId      String
  serviceTypeId   String
  serviceTypeName String
  familyId        String
  personId        String?
  membershipId    String?
  executorName    String
  executorRole    String
  occurredAt      DateTime                  @db.Date
  recordedAt      DateTime                  @default(now()) @db.Timestamptz
  recordedBy      String
  note            String?
  status          ServiceRecordStatus       @default(COMPLETED)
  revision        Int                       @default(1)
  homeVisit       HomeVisit?
  auditEntries    ServiceRecordAuditEntry[]
  delivery        Delivery?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([familyId, occurredAt(sort: Desc)])
  @@index([personId])
}

model HomeVisit {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceRecordId   String        @unique @db.Uuid
  serviceRecord     ServiceRecord @relation(fields: [serviceRecordId], references: [id])
  observedSituation String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model ServiceRecordAuditEntry {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceRecordId String        @db.Uuid
  serviceRecord   ServiceRecord @relation(fields: [serviceRecordId], references: [id])
  operation       String // "CREATED" | "CANCELED" | "NOTE_CORRECTED"
  performedBy     String
  performedAt     DateTime      @default(now()) @db.Timestamptz
  before          Json?
  after           Json?
  reason          String?
  createdAt       DateTime      @default(now())

  @@index([serviceRecordId])
}

enum DonationOriginType {
  PERSON
  ORGANIZATION
  CAMPAIGN
  BAZAR
  AD_HOC
  UNKNOWN
}

model Category {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @unique @db.VarChar(100)
  description String?   @db.VarChar(500)
  isActive    Boolean   @default(true)
  revision    Int       @default(1)
  items       Item[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([name])
}

model Unit {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  symbol            String    @unique @db.VarChar(20)
  name              String    @db.VarChar(100)
  decimalPlaces     Int       @db.SmallInt
  quantityIncrement Decimal   @db.Decimal(10, 4)
  isActive          Boolean   @default(true)
  revision          Int       @default(1)
  items             Item[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Item {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId         String    @db.Uuid
  category           Category  @relation(fields: [categoryId], references: [id])
  unitId             String    @db.Uuid
  unit               Unit      @relation(fields: [unitId], references: [id])
  name               String    @db.VarChar(200)
  description        String?   @db.VarChar(500)
  requiresExpiration Boolean
  isActive           Boolean   @default(true)
  revision           Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([categoryId, name])
  @@index([categoryId])
  @@index([name])
}

enum MovementType {
  DONATION_IN
  BAZAR_IN
  TRIAGE_DISCARD
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  OPENING_BALANCE
  DELIVERY_OUT
  DELIVERY_REVERSAL
}

model StockReceipt {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  originType   DonationOriginType
  donorName    String?            @db.VarChar(200)
  receivedBy   String
  receivedAt   DateTime           @db.Date
  note         String?            @db.VarChar(500)
  operationKey String             @unique
  fingerprint  String
  lines        ReceiptLine[]
  bazarTransfer BazarTransfer?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([receivedAt])
}

model ReceiptLine {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptId        String       @db.Uuid
  receipt          StockReceipt @relation(fields: [receiptId], references: [id])
  itemId           String       @db.Uuid
  unitId           String       @db.Uuid
  informedQuantity Decimal?     @db.Decimal(14, 4)
  receivedQuantity Decimal      @db.Decimal(14, 4)
  acceptedQuantity Decimal      @db.Decimal(14, 4)
  rejectedQuantity Decimal      @db.Decimal(14, 4)
  rejectionReason  String?      @db.VarChar(500)
  expiresOn        DateTime?    @db.Date
  lot              StockLot?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([receiptId])
  @@index([itemId])
}

model StockLot {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId        String       @db.Uuid
  unitId        String       @db.Uuid
  receiptLineId String?      @unique @db.Uuid
  receiptLine   ReceiptLine? @relation(fields: [receiptLineId], references: [id])
  countLineId   String?      @unique @db.Uuid
  expiresOn     DateTime?    @db.Date
  movements     StockMovement[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([itemId, unitId])
}

model StockMovement {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId        String       @db.Uuid
  unitId        String       @db.Uuid
  lotId         String?      @db.Uuid
  lot           StockLot?    @relation(fields: [lotId], references: [id])
  receiptLineId String?      @db.Uuid
  countLineId   String?      @db.Uuid
  type          MovementType
  quantity      Decimal      @db.Decimal(14, 4)
  balanceDelta  Decimal      @db.Decimal(14, 4)
  occurredAt    DateTime     @db.Date
  recordedBy    String
  reason        String?      @db.VarChar(500)
  operationKey  String?      @unique
  reversesMovementId String? @unique @db.Uuid
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([itemId, unitId, occurredAt])
  @@index([lotId])
}

model StockCount {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conductedBy String
  conductedAt DateTime         @db.Date
  closedAt    DateTime?        @db.Date
  note        String?          @db.VarChar(500)
  lines       StockCountLine[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model StockCountLine {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countId          String     @db.Uuid
  count            StockCount @relation(fields: [countId], references: [id])
  itemId           String     @db.Uuid
  unitId           String     @db.Uuid
  lotId            String?    @db.Uuid
  expiresOn        DateTime?  @db.Date
  expectedQuantity Decimal    @db.Decimal(14, 4)
  countedQuantity  Decimal    @db.Decimal(14, 4)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([countId])
}

model Delivery {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceRecordId      String         @unique @db.Uuid
  serviceRecord        ServiceRecord  @relation(fields: [serviceRecordId], references: [id])
  familyId             String
  assessmentId         String
  eligibilityStatus    String         @db.VarChar(20)
  occurredAt           DateTime       @db.Date
  collectedByPersonId  String?        @db.Uuid
  collectedByMembershipId String?     @db.Uuid
  executorName         String         @db.VarChar(200)
  executorRole         String         @db.VarChar(200)
  exceptionReason      String?        @db.VarChar(500)
  authorizedBy         String?        @db.VarChar(200)
  operationKey         String         @unique
  fingerprint          String
  status               String         @default("COMPLETED") @db.VarChar(20)
  lines                DeliveryLine[]
  reversal             DeliveryReversal?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([familyId, occurredAt(sort: Desc)])
}

model DeliveryLine {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryId String   @db.Uuid
  delivery   Delivery @relation(fields: [deliveryId], references: [id])
  stockLotId String   @db.Uuid
  unitId     String   @db.Uuid
  quantity   Decimal  @db.Decimal(14, 4)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([deliveryId, stockLotId])
  @@index([deliveryId])
}

model DeliveryReversal {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryId String   @unique @db.Uuid
  delivery   Delivery @relation(fields: [deliveryId], references: [id])
  reason     String   @db.VarChar(500)
  reversedAt DateTime @db.Date
  reversedBy String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model BazarTransfer {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptId         String       @unique @db.Uuid
  receipt           StockReceipt @relation(fields: [receiptId], references: [id])
  externalReference String       @unique @db.VarChar(200)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([externalReference])
}
